# Clé API Resend (https://resend.com/api-keys) — nécessaire pour que le formulaire de contact envoie les e-mails.
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire (par défaut : felixmachenaud2@gmail.com).
CONTACT_TO_EMAIL=

# Expéditeur affiché. Avec un domaine vérifié sur Resend, par exemple : WebSite Studio <contact@felixtech.space>
# Sans domaine vérifié, laissez vide : l'adresse de test onboarding@resend.dev est utilisée.
CONTACT_FROM_EMAIL=
